{
  "$schema-note": "verdigris design tokens v0.1. Source of truth; tokens.css is generated from this (hand-synced until a build step exists).",
  "color": {
    "bg": {
      "base":    { "value": "#17130F", "role": "App background. Oxidized iron, never pure black." },
      "surface": { "value": "#1F1A16", "role": "Panels, tables." },
      "raised":  { "value": "#29221D", "role": "Hover, selected row, popovers." },
      "sunken":  { "value": "#110E0B", "role": "Code/body viewers, inputs." }
    },
    "border": {
      "subtle": { "value": "#3A312A", "role": "Gridlines, dividers. Barely there." },
      "strong": { "value": "#54483E", "role": "Focus-adjacent edges, active panel outline." }
    },
    "text": {
      "primary":   { "value": "#E8DED3", "role": "Data and content. Full brightness is for content only." },
      "secondary": { "value": "#ADA092", "role": "Labels, column headers, metadata." },
      "tertiary":  { "value": "#958779", "role": "Hints, timestamps. Not for body text on bg.raised." }
    },
    "accent": {
      "verdigris":      { "value": "#4FBFAD", "role": "SIGNATURE. Live / active / connected ONLY. Never decorative." },
      "verdigris-glow": { "value": "#4FBFAD59", "role": "Glow halo for the live indicator (35% alpha)." },
      "rust":           { "value": "#DE7848", "role": "Brand / primary action / focus ring." }
    },
    "http-status": {
      "2xx": { "value": "#A3B97F" },
      "3xx": { "value": "#86A9CC" },
      "4xx": { "value": "#E2AB4A" },
      "5xx": { "value": "#E9716A" },
      "none": { "value": "#958779", "role": "No response / pending." }
    },
    "http-method": {
      "GET":    { "value": "#E6D6B0" },
      "POST":   { "value": "#E8894A" },
      "PUT":    { "value": "#DDB94E" },
      "PATCH":  { "value": "#C99BD6" },
      "DELETE": { "value": "#E66A55" },
      "other":  { "value": "#9E9185" }
    },
    "severity": {
      "note-for-later": "Finding severity colors land with spall M3. Do not reuse http-status colors for severity."
    }
  },
  "font": {
    "mono": { "value": "'IBM Plex Mono', ui-monospace, 'SF Mono', Menlo, monospace", "role": "All data: URLs, headers, bodies, IDs, numbers." },
    "sans": { "value": "'IBM Plex Sans', system-ui, sans-serif", "role": "UI chrome and prose." }
  },
  "font-size": {
    "xs": { "value": "11px" },
    "sm": { "value": "12px" },
    "md": { "value": "13px", "role": "Default for dense data views." },
    "lg": { "value": "15px" },
    "xl": { "value": "18px" }
  },
  "space": {
    "1": { "value": "2px" },
    "2": { "value": "4px" },
    "3": { "value": "8px" },
    "4": { "value": "12px" },
    "5": { "value": "16px" },
    "6": { "value": "24px" },
    "7": { "value": "32px" }
  },
  "radius": {
    "sm": { "value": "2px", "role": "Default. Hardware edges, not bubbles." },
    "md": { "value": "4px" }
  },
  "row-height": {
    "dense":   { "value": "26px", "role": "Default for traffic and findings tables." },
    "relaxed": { "value": "32px" }
  },
  "motion": {
    "fast":   { "value": "80ms" },
    "base":   { "value": "140ms" },
    "pulse":  { "value": "1.6s", "role": "Live indicator pulse period only." },
    "easing": { "value": "cubic-bezier(0.2, 0, 0, 1)" }
  }
}
