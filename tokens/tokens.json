{
  "version": "0.2.0",
  "default_theme": "rust",
  "roles": {
    "bg-base": "App background. Never pure black or pure white.",
    "bg-surface": "Panels, tables.",
    "bg-raised": "Hover, selected row, popovers.",
    "bg-sunken": "Code/body viewers, inputs.",
    "border-subtle": "Gridlines, dividers. Barely there.",
    "border-strong": "Active panel outline, control edges.",
    "text-primary": "Data and content. Full contrast is for content only.",
    "text-secondary": "Labels, column headers, metadata.",
    "text-tertiary": "Hints, timestamps.",
    "accent-verdigris": "SIGNATURE. Live / active / connected ONLY. Never decorative.",
    "accent-verdigris-glow": "Halo for the live indicator.",
    "accent-rust": "Brand / primary action / focus ring. Same identity in every theme.",
    "status-*": "HTTP status class, as text color. Always shown with the number.",
    "method-*": "HTTP method label (808-style category color). Always shown with the text."
  },
  "contrast": {
    "min_ratio": 4.5,
    "required_on": ["bg-base", "bg-surface"],
    "reported_on": ["bg-raised"],
    "text_tokens": ["text-primary", "text-secondary", "text-tertiary", "accent-verdigris", "accent-rust",
                    "status-2xx", "status-3xx", "status-4xx", "status-5xx", "status-none",
                    "method-get", "method-post", "method-put", "method-patch", "method-delete", "method-other"]
  },
  "themes": {
    "rust": {
      "label": "Rust", "scheme": "dark",
      "bg-base": "#17130F", "bg-surface": "#1F1A16", "bg-raised": "#29221D", "bg-sunken": "#110E0B",
      "border-subtle": "#3A312A", "border-strong": "#54483E",
      "text-primary": "#E8DED3", "text-secondary": "#ADA092", "text-tertiary": "#958779",
      "accent-verdigris": "#4FBFAD", "accent-verdigris-glow": "#4FBFAD59", "accent-rust": "#DE7848",
      "status-2xx": "#A3B97F", "status-3xx": "#86A9CC", "status-4xx": "#E2AB4A", "status-5xx": "#E9716A", "status-none": "#958779",
      "method-get": "#E6D6B0", "method-post": "#E8894A", "method-put": "#DDB94E", "method-patch": "#C99BD6", "method-delete": "#E66A55", "method-other": "#9E9185"
    },
    "rust-light": {
      "label": "Rust Light", "scheme": "light",
      "bg-base": "#F3EEE7", "bg-surface": "#FAF7F2", "bg-raised": "#E9E1D6", "bg-sunken": "#EDE6DC",
      "border-subtle": "#DCD2C5", "border-strong": "#BFB2A2",
      "text-primary": "#2A211B", "text-secondary": "#5B4F44", "text-tertiary": "#6F6256",
      "accent-verdigris": "#18705F", "accent-verdigris-glow": "#18705F4D", "accent-rust": "#A5461B",
      "status-2xx": "#4A6527", "status-3xx": "#2D5B88", "status-4xx": "#855600", "status-5xx": "#AF372E", "status-none": "#6F6256",
      "method-get": "#5F5129", "method-post": "#A14B13", "method-put": "#775F00", "method-patch": "#7A468E", "method-delete": "#AC3826", "method-other": "#665A50"
    },
    "blued": {
      "label": "Blued", "scheme": "dark",
      "bg-base": "#0F1318", "bg-surface": "#151A21", "bg-raised": "#1D242D", "bg-sunken": "#0A0D11",
      "border-subtle": "#2A323D", "border-strong": "#3D4754",
      "text-primary": "#DCE3EA", "text-secondary": "#9AA6B3", "text-tertiary": "#838F9C",
      "accent-verdigris": "#4FBFAD", "accent-verdigris-glow": "#4FBFAD59", "accent-rust": "#DE7848",
      "status-2xx": "#A3B97F", "status-3xx": "#8DB2DE", "status-4xx": "#E2AB4A", "status-5xx": "#E9716A", "status-none": "#838F9C",
      "method-get": "#E6D6B0", "method-post": "#E8894A", "method-put": "#DDB94E", "method-patch": "#C99BD6", "method-delete": "#E66A55", "method-other": "#9AA6B3"
    },
    "blued-light": {
      "label": "Blued Light", "scheme": "light",
      "bg-base": "#EDF1F5", "bg-surface": "#F7F9FB", "bg-raised": "#E0E7EE", "bg-sunken": "#E6ECF2",
      "border-subtle": "#D0D8E1", "border-strong": "#B1BDCA",
      "text-primary": "#18202A", "text-secondary": "#465468", "text-tertiary": "#5B687A",
      "accent-verdigris": "#18705F", "accent-verdigris-glow": "#18705F4D", "accent-rust": "#A5461B",
      "status-2xx": "#4A6527", "status-3xx": "#2D5B88", "status-4xx": "#855600", "status-5xx": "#AF372E", "status-none": "#5B687A",
      "method-get": "#5F5129", "method-post": "#A14B13", "method-put": "#775F00", "method-patch": "#7A468E", "method-delete": "#AC3826", "method-other": "#5B687A"
    }
  },
  "scale": {
    "font-mono": "'IBM Plex Mono', ui-monospace, 'SF Mono', Menlo, monospace",
    "font-sans": "'IBM Plex Sans', system-ui, sans-serif",
    "text-xs": "11px", "text-sm": "12px", "text-md": "13px", "text-lg": "15px", "text-xl": "18px",
    "space-1": "2px", "space-2": "4px", "space-3": "8px", "space-4": "12px", "space-5": "16px", "space-6": "24px", "space-7": "32px",
    "radius-sm": "2px", "radius-md": "4px",
    "row-dense": "26px", "row-relaxed": "32px",
    "motion-fast": "80ms", "motion-base": "140ms", "motion-pulse": "1.6s",
    "easing": "cubic-bezier(0.2, 0, 0, 1)"
  }
}
